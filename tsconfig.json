{
  "compilerOptions": {
    "target": "ES2020",
    "lib": [
      "dom",
      "dom.iterable",
      "ESNext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./*"],
      "@styles/*": ["./src/assets/styles/*"],
      "@fonts/*": ["./src/assets/fonts/*"],
      "@templates": ["./src/app/lib/templates"],
      "@types_ts": ["./src/app/lib/types/index.ts"],
      "@components": ["./src/app/lib/components/index.ts"],
      "@entities/*": ["./src/app/lib/entities/*"],
      "@server/*": ["./src/app/lib/server/*"],
      "@services/*": ["./src/app/lib/services/*"],
      "@auth/*": ["./src/app/lib/auth/*"],
      "@prisma/*": ["./src/app/lib/prisma/*"],
      "@commands/*": ["./src/app/lib/commands/*"],
      "@context/*": ["./src/app/lib/context/*"],
      "@hoc/*": ["./src/app/lib/hoc/*"],
      "@svgs": ["./src/app/lib/svgs"],
      "@utils/*": ["./src/app/lib/utils/*"],
      "@styles_ts/*": ["./src/app/lib/styles/*"],
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    "src/middleware.ts",
    "src/app/lib/components/lists/default_party_list.tsx"
  ],
  "exclude": [
    "node_modules"
  ],
  "ts-node": {
    "require": [
      "tsconfig-paths/register"
    ]
  }
}
