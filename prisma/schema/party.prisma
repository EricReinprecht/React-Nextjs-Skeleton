model Party {
    id             String              @id @default(cuid())
    name           String
    location       String
    latitude       Float
    longitude      Float
    startDate      DateTime
    endDate        DateTime
    description    String
    teaser         String

    status         PartyStatus          @default(draft)
    
    createdAt      DateTime             @default(now())
    updatedAt      DateTime?            @updatedAt

    // relations
    categories      PartyCategory[]    @relation("PartyToCategory")
    
    userId          String
    createdBy       User               @relation("UserToParty", fields: [userId], references: [id])
    
    tickets         Ticket[]           @relation("PartyToTicket")
    ticketClasses   TicketClass[]      @relation("PartyToTicketClass")
    images          Image[]            @relation("PartyImages")
}

enum PartyStatus {
    draft
    hot
    published
    hidden
}