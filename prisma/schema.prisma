// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
    provider = "prisma-client-js"
    // output   = "../src/generated/prisma"
}

datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

model Image {
    id         String   @id @default(cuid())
    url        String
    alt        String?
    caption    String?
    createdAt  DateTime @default(now())

    partyId    String
    party      Party    @relation(fields: [partyId], references: [id])
}

model Party {
    id             String    @id @default(cuid())
    created        String
    name           String
    location       String
    latitude       Float
    longitude      Float
    startDate      DateTime
    endDate        DateTime
    description    String
    teaser         String
    categories     PartyCategory[]  @relation("PartyToCategory")
    tickets        Ticket[]
    images         Image[]
}

model PartyCategory {
    id             String    @id @default(cuid())
    name           String
    active         Boolean
    parties   Party[]  @relation("PartyToCategory")
}

model Ticket {
    id String @id @default(cuid())
    categories     TicketCategory[]  @relation("TicketToCategory")

    partyId   String
    party     Party   @relation(fields: [partyId], references: [id])
}

model TicketCategory {
    id             String    @id @default(cuid())
    name           String
    active         Boolean
    tickets        Ticket[]  @relation("TicketToCategory")
}

model User {
    id             String    @id @default(cuid())
    username       String    @unique
    email          String    @unique
    firstname      String
    lastname       String
    birthdate      DateTime
    country        String
    zip            Int
    city           String
    street         String
    housenumber    Int
    unit           String?
    createdParties String[]  @default([])
    createdAt      DateTime  @default(now())
}