// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
    provider = "prisma-client-js"
    // output   = "../src/generated/prisma"
}

datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

model Account {
    id                 String  @id @default(cuid())
    userId             String
    type               String
    provider           String
    providerAccountId  String
    refresh_token      String?
    access_token       String?
    expires_at         Int?
    token_type         String?
    scope              String?
    id_token           String?
    session_state      String?

    user User @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@unique([provider, providerAccountId])
}

model Image {
    id          String   @id @default(cuid())
    createdAt   DateTime @default(now())
    path        String

    partyId     String?
    party       Party?   @relation("PartyImages", fields: [partyId], references: [id])

    // userId    String?  @unique(map: "userId_idx")
    // user      User?    @relation("UserImage", fields: [userId], references: [id])
}

model Invoice {
    id        String      @id @default(cuid())
    total     Float

    status    InvoiceStatus @default(PENDING)

    createdAt DateTime    @default(now())
    updatedAt DateTime    @updatedAt

    // relations
    user      User?       @relation(fields: [userId], references: [id], name: "UserToInvoice")
    userId    String?
    items     InvoiceItem[]
}

enum InvoiceStatus {
    PENDING
    PAID
    CANCELLED
}

model InvoiceItem {
    id           String      @id @default(cuid())
    invoice      Invoice     @relation(fields: [invoiceId], references: [id])
    invoiceId    String
    ticketClass  TicketClass @relation(fields: [ticketClassId], references: [id])
    ticketClassId String
    quantity     Int
    price        Float       
    currency     String
    createdAt    DateTime    @default(now())
    updatedAt    DateTime    @updatedAt
}

model Party {
    id             String              @id @default(cuid())
    name           String
    location       String
    latitude       Float
    longitude      Float
    startDate      DateTime
    endDate        DateTime
    description    String
    teaser         String

    status         PartyStatus          @default(draft)
    
    createdAt      DateTime             @default(now())
    updatedAt      DateTime?            @updatedAt

    // relations
    categories      PartyCategory[]    @relation("PartyToCategory")
    
    userId          String
    createdBy       User               @relation("UserToParty", fields: [userId], references: [id])
    
    tickets         Ticket[]           @relation("PartyToTicket")
    ticketClasses   TicketClass[]      @relation("PartyToTicketClass")
    images          Image[]            @relation("PartyImages")
}

enum PartyStatus {
    draft
    hot
    published
    hidden
}

model PartyCategory {
    id             String    @id @default(cuid())
    name           String    @unique
    active         Boolean

    createdAt      DateTime     @default(now())
    
    // relations
    parties        Party[]  @relation("PartyToCategory")
}

model Session {
    id           String   @id @default(cuid())
    sessionToken String   @unique
    userId       String
    expires      DateTime

    user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ShoppingCart {
    id        String                @id @default(cuid())
    
    status    ShoppingCartStatus    @default(ACTIVE)
    createdAt DateTime              @default(now())
    updatedAt DateTime              @updatedAt
    expiresAt DateTime?

    // relations
    user      User?                 @relation(fields: [userId], references: [id], "UserToShoppingCart")
    userId    String?
    items     ShoppingCartItem[]
    reservations TicketReservation[]
}

enum ShoppingCartStatus {
    ACTIVE
    CHECKED_OUT
    EXPIRED
}

model ShoppingCartItem {
    id                  String          @id @default(cuid())
    shoppingCart        ShoppingCart    @relation(fields: [shoppingCartId], references: [id])
    shoppingCartId      String
    ticketClass         TicketClass     @relation(fields: [ticketClassId], references: [id])
    ticketClassId       String
    quantity            Int
    createdAt           DateTime        @default(now())
    updatedAt           DateTime        @updatedAt
}

model Ticket {
    id            String       @id @default(cuid())
    
    createdAt      DateTime     @default(now())
    
    // relations
    partyId       String
    party         Party        @relation("PartyToTicket", fields: [partyId], references: [id])
    
    ticketClassId String
    ticketClass   TicketClass  @relation("TicketClassToTickets", fields: [ticketClassId], references: [id])
}

model TicketClass {
    id             String       @id @default(cuid())
    name           String
    description    String
    validFrom      DateTime
    validTo        DateTime
    ticketAmount   Int

    createdAt      DateTime     @default(now())
    updatedAt      DateTime?    @updatedAt

    // relations 
    prices              TicketClassPrice[]
    invoiceItems        InvoiceItem[]
    shoppingCartItems   ShoppingCartItem[] 
    
    partyId         String
    party           Party                   @relation("PartyToTicketClass", fields: [partyId], references: [id])
    tickets         Ticket[]                @relation("TicketClassToTickets")
    reservations    TicketReservation[]     @relation("TicketClassToTicketReservation")
}

model TicketClassPrice {
    id             String       @id @default(cuid())
    amount         Int
    price          Decimal
    currency       Currency     @default(EUR)

    createdAt      DateTime     @default(now())
    updatedAt      DateTime?    @updatedAt

    // relations
    ticketClassId  String
    ticketClass    TicketClass  @relation(fields: [ticketClassId], references: [id])
}

enum Currency {
    EUR
    USD
}

model TicketReservation {
    id              String          @id @default(cuid())
    quantity        Int
    expiresAt       DateTime     
    createdAt       DateTime        @default(now())
    updatedAt       DateTime        @updatedAt

    // relations
    ticketClass     TicketClass     @relation(fields: [ticketClassId], references: [id], "TicketClassToTicketReservation")
    ticketClassId   String
    cart            ShoppingCart    @relation(fields: [shoppingCartId], references: [id])
    shoppingCartId  String
}

model User {
    id                  String          @id @default(cuid())
    username            String          @unique
    email               String          @unique
    emailVerified       DateTime?
    password            String
    sessions            Session[]
    accounts            Account[]

    firstname           String
    lastname            String
    birthdate           DateTime
    country             String
    zip                 Int
    city                String
    street              String
    housenumber         Int
    unit                String?

    language            Language        @default(en)

    createdAt           DateTime        @default(now())
    updatedAt           DateTime?       @updatedAt


    // relations        
    createdParties      Party[]         @relation("UserToParty")
    shoppingCarts       ShoppingCart[]  @relation("UserToShoppingCart")
    invoices            Invoice[]       @relation("UserToInvoice")
}

enum Language {
    de
    en
}

model VerificationToken {
    identifier String
    token      String   @unique
    expires    DateTime

    @@unique([identifier, token])
}