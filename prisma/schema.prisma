// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
    provider = "prisma-client-js"
    // output   = "../src/generated/prisma"
}

datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

model Account {
    id                 String  @id @default(cuid())
    userId             String
    type               String
    provider           String
    providerAccountId  String
    refresh_token      String?
    access_token       String?
    expires_at         Int?
    token_type         String?
    scope              String?
    id_token           String?
    session_state      String?

    user User @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@unique([provider, providerAccountId])
}

model Image {
    id          String   @id @default(cuid())
    createdAt   DateTime @default(now())
    path        String

    partyId     String?
    party       Party?   @relation("PartyImages", fields: [partyId], references: [id])

    // userId    String?  @unique(map: "userId_idx")
    // user      User?    @relation("UserImage", fields: [userId], references: [id])
}

model Party {
    id           String        @id @default(cuid())
    created      DateTime
    name         String
    location     String
    latitude     Float
    longitude    Float
    startDate    DateTime
    endDate      DateTime
    description  String
    teaser       String
    
    categories   PartyCategory[] @relation("PartyToCategory")
    
    userId       String
    createdBy    User           @relation("UserToParty", fields: [userId], references: [id])
    
    tickets      Ticket[]       @relation("PartyToTicket")
    ticketClasses TicketClass[] @relation("PartyToTicketClass")
    images       Image[]        @relation("PartyImages")
}

model PartyCategory {
    id             String    @id @default(cuid())
    name           String    @unique
    active         Boolean
    
    parties        Party[]  @relation("PartyToCategory")
}

model Session {
    id           String   @id @default(cuid())
    sessionToken String   @unique
    userId       String
    expires      DateTime

    user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Ticket {
    id            String       @id @default(cuid())
    
    partyId       String
    party         Party        @relation("PartyToTicket", fields: [partyId], references: [id])
    
    ticketClassId String
    ticketClass   TicketClass  @relation("TicketClassToTickets", fields: [ticketClassId], references: [id])
}

model TicketClass {
    id          String   @id @default(cuid())
    name        String
    description String
    
    partyId     String
    party       Party    @relation("PartyToTicketClass", fields: [partyId], references: [id])
    
    tickets     Ticket[] @relation("TicketClassToTickets")
}

model User {
    id             String    @id @default(cuid())
    username       String    @unique
    email          String    @unique
    emailVerified  DateTime?
    password       String
    sessions       Session[]
    accounts       Account[]

    firstname      String
    lastname       String
    birthdate      DateTime
    country        String
    zip            Int
    city           String
    street         String
    housenumber    Int
    unit           String?
    createdAt      DateTime  @default(now())

    createdParties Party[] @relation("UserToParty")
}

model VerificationToken {
    identifier String
    token      String   @unique
    expires    DateTime

    @@unique([identifier, token])
}