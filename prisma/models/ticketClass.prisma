model TicketClass {
    id             String       @id @default(cuid())
    name           String
    description    String
    validFrom      DateTime
    validTo        DateTime
    ticketAmount   Int

    createdAt      DateTime     @default(now())
    updatedAt      DateTime?    @updatedAt

    // relations 
    prices          TicketClassPrice[]
    
    partyId         String
    party           Party       @relation("PartyToTicketClass", fields: [partyId], references: [id])
    
    tickets         Ticket[]    @relation("TicketClassToTickets")
}