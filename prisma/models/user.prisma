model User {
    id             String    @id @default(cuid())
    username       String    @unique
    email          String    @unique
    password       String
    firstname      String
    lastname       String
    birthdate      DateTime
    country        String
    zip            Int
    city           String
    street         String
    housenumber    Int
    unit           String?
    createdParties String[]  @default([])
    createdAt      DateTime  @default(now())
}