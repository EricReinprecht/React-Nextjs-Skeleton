model User {
    id             String      @id @default(cuid())
    username       String      @unique
    email          String      @unique
    emailVerified  DateTime?
    password       String
    sessions       Session[]
    accounts       Account[]

    firstname      String
    lastname       String
    birthdate      DateTime
    country        String
    zip            Int
    city           String
    street         String
    housenumber    Int
    unit           String?

    language       Language     @default(en)
    
    createdAt      DateTime     @default(now())
    updatedAt      DateTime?    @updatedAt

    
    // relations
    createdParties Party[]      @relation("UserToParty")
}

enum Language {
    de
    en
}