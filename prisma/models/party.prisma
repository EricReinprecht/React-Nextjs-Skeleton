model Party {
    id             String    @id @default(cuid())
    created        DateTime
    name           String
    location       String
    latitude       Float
    longitude      Float
    startDate      DateTime
    endDate        DateTime
    description    String
    teaser         String
    categories     PartyCategory[]  @relation("PartyToCategory")

    userId         String
    createdBy      User  @relation ("UserToParty", fields: [userId], references: [id])

    tickets        Ticket[]
    images         Image[]
}